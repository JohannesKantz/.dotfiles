# Curl configuration
# https://curl.se/docs/manpage.html
# Loaded automatically from ~/.curlrc

# Show a progress bar for downloads
--progress-bar

# Follow redirects
--location

# Retry up to 3 times on transient failures
--retry 3

# Wait 5 seconds between retries
--retry-delay 5

# Show error messages even with --silent
--show-error
