{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "keyWidth": 3
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌─────────  Hardware Information  ─────────┐"
        },
        {
            "type": "host",
            "key": " 󰌢 "
        },
        {
            "type": "cpu",
            "key": " 󰍛 ",
            "temp": false,
            "showPeCoreCount": false
        },
        {
            "type": "gpu",
            "key": " 󰘚 "
        },
        {
            "type": "memory",
            "key": " 󰑭 "
        },
        {
            "type": "display",
            "key": " 󰍹 ",
            "compactType": "original-with-refresh-rate"
        },
        {
            "type": "disk",
            "key": "   ",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "├─────────  Software Information  ─────────┤"
        },
        {
            "type": "os",
            "key": "   "
        },
        {
            "type": "kernel",
            "key": "   "
        },
        {
            "type": "wm",
            "key": "   "
        },
        {
            "type": "shell",
            "key": "   "
        },
        {
            "type": "terminal",
            "key": "   "
        },
        {
            "type": "terminalfont",
            "key": "   "
        },
        {
            "type": "packages",
            "key": " 󰊠 "
        },
        {
            "type": "uptime",
            "key": " 󰅐 "
        },
        {
            "type": "custom",
            "format": "└───────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
